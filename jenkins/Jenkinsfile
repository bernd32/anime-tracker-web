def withRemoteDocker(Closure body) {
    sshagent(credentials: [env.DEPLOY_CREDENTIALS]) {
        withEnv([
            "DOCKER_HOST=ssh://${env.DEPLOY_USER}@${env.DEPLOY_HOST}",
            "DOCKER_SSH_COMMAND=ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
        ]) {
            body()
        }
    }
}

pipeline {
    agent any

    environment {
        DOCKER_BUILDKIT = '1'
        NEXT_PUBLIC_API_BASE_URL = 'http://localhost:43968/api/v1'
        NEXT_TELEMETRY_DISABLED = '1'
        NPM_CONFIG_UPDATE_NOTIFIER = 'false'
        PIP_DISABLE_PIP_VERSION_CHECK = '1'
        PIP_NO_CACHE_DIR = '1'
        PYTHON_VERSION = '3.14'
        NODE_VERSION = '22'
        DEPLOY_HOST        = '89.169.147.94'
        DEPLOY_USER        = 'bernd'
        // DEPLOY_CREDENTIALS = 'deploy-key-test'
        DEPLOY_CREDENTIALS = 'deploy-key-cloud'
        DEPLOY_ENV_FILE_CREDENTIALS = 'anime-backlog-env'
        DOCKERHUB_NAMESPACE   = 'skeirs'
        DOCKERHUB_CREDENTIALS = 'dockerhub-credentials'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds(abortPrevious: true)
        skipDefaultCheckout(true)
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
    }



    stages {

        stage('SSH test') {

            steps {
                sshagent(credentials: [env.DEPLOY_CREDENTIALS]) {
                    sh '''
                        ssh ${DEPLOY_USER}@${DEPLOY_HOST} hostname
                    '''
                }
            }     
        }   

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_SHA_SHORT = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()
                }
                echo "Building commit ${env.GIT_SHA_SHORT}"
            }
        }

        stage('Quality Gates') {
            parallel {
                stage('Backend') {
                    agent {
                        docker {
                            image 'python:3.14-slim-bookworm'
                            reuseNode true
                        }
                    }
                    steps {
                        dir('backend') {
                            sh '''
                                set -eu
                                trap 'chmod -R a+rwX . || true' EXIT
                                mkdir -p reports

                                python --version
                                python -m venv .venv
                                . .venv/bin/activate
                                python -m pip install --upgrade pip
                                python -m pip install -e ".[dev]"
                                pytest -q --junitxml=reports/pytest.xml
                            '''
                        }
                        script {
                            dir('backend') {
                                // Non-blocking: pip-audit findings are reported but never fail the build.
                                def auditStatus = sh(
                                    script: '''
                                        set -eu
                                        trap 'chmod -R a+rwX reports || true' EXIT
                                        . .venv/bin/activate
                                        echo "Running pip-audit (dependency vulnerability scan)"

                                        # The docker agent doesn't provide a writable/valid $HOME,
                                        # so pip-audit's cache dir resolver falls back to /.cache
                                        # (permission denied). Point HOME at the workspace instead.
                                        export HOME="$PWD"
                                        mkdir -p "$HOME/.cache"

                                        python -m pip install pip-audit

                                        set +e
                                        pip-audit --desc --format json --output reports/pip-audit.json
                                        STATUS=$?
                                        pip-audit --desc > reports/pip-audit.txt 2>&1
                                        set -e

                                        {
                                            echo '<html><head><meta charset="utf-8"><title>pip-audit report</title>'
                                            echo '<style>body{font-family:monospace;background:#1e1e1e;color:#ddd;padding:16px}pre{white-space:pre-wrap;word-break:break-word}</style>'
                                            echo '</head><body><h2>pip-audit report</h2><pre>'
                                            sed -e "s/&/\\&amp;/g" -e "s/</\\&lt;/g" -e "s/>/\\&gt;/g" reports/pip-audit.txt
                                            echo '</pre></body></html>'
                                        } > reports/pip-audit.html

                                        exit "${STATUS}"
                                    ''',
                                    returnStatus: true
                                )
                                if (auditStatus != 0) {
                                    unstable(message: 'pip-audit found vulnerable backend dependencies (see pip-audit report)')
                                }
                            }
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'backend/reports/pytest.xml'
                            archiveArtifacts artifacts: 'backend/reports/pip-audit.json, backend/reports/pip-audit.txt, backend/reports/pip-audit.html', allowEmptyArchive: true
                            publishHTML(target: [
                                allowMissing: true,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'backend/reports',
                                reportFiles: 'pip-audit.html',
                                reportName: 'pip-audit Report'
                            ])
                        }
                    }
                }

                stage('Frontend') {
                    agent {
                        docker {
                            image 'node:22-bookworm-slim'
                            reuseNode true
                        }
                    }
                    steps {
                        dir('frontend') {
                            sh '''
                                set -eu
                                trap 'chmod -R a+rwX . || true' EXIT
                                mkdir -p reports

                                node --version
                                npm --version
                                npm ci --no-audit
                                npm run typecheck
                                npm test -- --reporter=default --reporter=junit --outputFile=reports/vitest.xml
                                npm run build
                            '''
                        }
                        script {
                            dir('frontend') {
                                // Non-blocking: npm audit findings are reported but never fail the build.
                                def auditStatus = sh(
                                    script: '''
                                        set -eu
                                        trap 'chmod -R a+rwX reports || true' EXIT
                                        echo "Running npm audit (dependency vulnerability scan)"

                                        set +e
                                        npm audit --json > reports/npm-audit.json
                                        npm audit > reports/npm-audit.txt 2>&1
                                        npm audit --audit-level=high >/dev/null 2>&1
                                        STATUS=$?
                                        set -e

                                        {
                                            echo '<html><head><meta charset="utf-8"><title>npm audit report</title>'
                                            echo '<style>body{font-family:monospace;background:#1e1e1e;color:#ddd;padding:16px}pre{white-space:pre-wrap;word-break:break-word}</style>'
                                            echo '</head><body><h2>npm audit report</h2><pre>'
                                            sed -e "s/&/\\&amp;/g" -e "s/</\\&lt;/g" -e "s/>/\\&gt;/g" reports/npm-audit.txt
                                            echo '</pre></body></html>'
                                        } > reports/npm-audit.html

                                        exit "${STATUS}"
                                    ''',
                                    returnStatus: true
                                )
                                if (auditStatus != 0) {
                                    unstable(message: 'npm audit found high/critical vulnerable frontend dependencies (see npm-audit report)')
                                }
                            }
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'frontend/reports/vitest.xml'
                            archiveArtifacts artifacts: 'frontend/reports/npm-audit.json, frontend/reports/npm-audit.txt, frontend/reports/npm-audit.html', allowEmptyArchive: true
                            publishHTML(target: [
                                allowMissing: true,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'frontend/reports',
                                reportFiles: 'npm-audit.html',
                                reportName: 'npm audit Report'
                            ])
                        }
                    }
                }
            }
        }

        stage('Container Image Build') {

            steps {
                withRemoteDocker {
                        sh '''
                            set -eu

                            docker build \
                                --pull \
                                --target runtime \
                                --build-arg PYTHON_VERSION="${PYTHON_VERSION}" \
                                --tag "anime-backlog-api:${BUILD_NUMBER}" \
                                backend

                            docker build \
                                --pull \
                                --target runtime \
                                --build-arg NODE_VERSION="${NODE_VERSION}" \
                                --tag "anime-backlog-frontend:${BUILD_NUMBER}" \
                                frontend
                        '''                    
                }
            }
        }

        stage('Security Scan (Trivy)') {

            steps {
                script {
                    withRemoteDocker {
                        sh '''
                            set -eu
                            mkdir -p reports images

                            if ! command -v trivy >/dev/null 2>&1; then
                                echo "trivy not found on agent, installing to ./bin"
                                curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b "$PWD/bin"
                                export PATH="$PWD/bin:$PATH"
                            fi

                            trivy image --download-db-only

                            # trivy's own Docker client can't talk to DOCKER_HOST=ssh://...,
                            # so pull the images down as local tarballs via the docker CLI
                            # (which does support ssh://) and point trivy at the tarballs instead.
                            echo "Saving images from the remote Docker host for local scanning"
                            docker save "anime-backlog-api:${BUILD_NUMBER}" -o images/anime-backlog-api.tar
                            docker save "anime-backlog-frontend:${BUILD_NUMBER}" -o images/anime-backlog-frontend.tar

                            scan_image() {
                                name="$1"
                                tarball="$2"

                                trivy image \
                                    --input "${tarball}" \
                                    --format table \
                                    --severity CRITICAL,HIGH \
                                    --output "reports/trivy-${name}.txt"

                                trivy image \
                                    --input "${tarball}" \
                                    --format json \
                                    --severity CRITICAL,HIGH \
                                    --output "reports/trivy-${name}.json"
                            }

                            scan_image api images/anime-backlog-api.tar
                            scan_image frontend images/anime-backlog-frontend.tar
                        '''

                        // Non-blocking: Trivy findings are reported but never fail the build.
                        def criticalStatus = sh(
                            script: '''
                                set -eu

                                if ! command -v trivy >/dev/null 2>&1; then
                                    export PATH="$PWD/bin:$PATH"
                                fi

                                set +e
                                trivy image --input images/anime-backlog-api.tar --exit-code 1 --severity CRITICAL --ignore-unfixed --quiet
                                API_STATUS=$?
                                trivy image --input images/anime-backlog-frontend.tar --exit-code 1 --severity CRITICAL --ignore-unfixed --quiet
                                FRONTEND_STATUS=$?
                                set -e

                                {
                                    echo '<html><head><meta charset="utf-8"><title>Trivy image scan report</title>'
                                    echo '<style>body{font-family:monospace;background:#1e1e1e;color:#ddd;padding:16px}pre{white-space:pre-wrap;word-break:break-word}h2{color:#9cdcfe}</style>'
                                    echo '</head><body>'
                                    echo '<h2>anime-backlog-api</h2><pre>'
                                    sed -e "s/&/\\&amp;/g" -e "s/</\\&lt;/g" -e "s/>/\\&gt;/g" reports/trivy-api.txt
                                    echo '</pre>'
                                    echo '<h2>anime-backlog-frontend</h2><pre>'
                                    sed -e "s/&/\\&amp;/g" -e "s/</\\&lt;/g" -e "s/>/\\&gt;/g" reports/trivy-frontend.txt
                                    echo '</pre></body></html>'
                                } > reports/trivy-report.html

                                rm -rf images

                                if [ "${API_STATUS}" -ne 0 ] || [ "${FRONTEND_STATUS}" -ne 0 ]; then
                                    exit 1
                                fi
                            ''',
                            returnStatus: true
                        )
                        if (criticalStatus != 0) {
                            unstable(message: 'Trivy found fixable CRITICAL vulnerabilities in built images (see Trivy report)')
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/trivy-*.txt, reports/trivy-*.json, reports/trivy-report.html', allowEmptyArchive: true
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'reports',
                        reportFiles: 'trivy-report.html',
                        reportName: 'Trivy Report'
                    ])
                }
            }
        }

        stage('Push to Registry') {

            steps {
                withRemoteDocker {
                    withCredentials([usernamePassword(
                        credentialsId: env.DOCKERHUB_CREDENTIALS,
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )]) {
                        sh '''
                            set -eu

                            echo "$DOCKERHUB_TOKEN" | docker login -u "$DOCKERHUB_USER" --password-stdin

                            docker tag "anime-backlog-api:${BUILD_NUMBER}" \
                                "${DOCKERHUB_NAMESPACE}/anime-backlog-api:${GIT_SHA_SHORT}"
                            docker tag "anime-backlog-frontend:${BUILD_NUMBER}" \
                                "${DOCKERHUB_NAMESPACE}/anime-backlog-frontend:${GIT_SHA_SHORT}"

                            docker push "${DOCKERHUB_NAMESPACE}/anime-backlog-api:${GIT_SHA_SHORT}"
                            docker push "${DOCKERHUB_NAMESPACE}/anime-backlog-frontend:${GIT_SHA_SHORT}"
                        '''
                    }
                }
            }
            post {
                always {
                    withRemoteDocker {
                        sh 'docker logout || true'
                    }
                }
            }
        }

        stage('Deploy') {

            steps {
                withRemoteDocker {
                    withCredentials([file(credentialsId: env.DEPLOY_ENV_FILE_CREDENTIALS, variable: 'ENV_FILE')]) {
                        sh '''
                            set -eu

                            export API_IMAGE="anime-backlog-api:${BUILD_NUMBER}"
                            export FRONTEND_IMAGE="anime-backlog-frontend:${BUILD_NUMBER}"

                            docker compose \
                                --env-file "$ENV_FILE" \
                                up -d \
                                --remove-orphans \
                                --wait \
                                --wait-timeout 90
                        '''
                    }
                }
            }
        }
    }

        post {
            success {
                withRemoteDocker {
                    sh 'docker image prune -f'
                }
            }
        }
}