pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds(abortPrevious: true)
        skipDefaultCheckout(true)
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
    }

    environment {
        DOCKER_BUILDKIT = '1'
        NEXT_PUBLIC_API_BASE_URL = 'http://localhost:43968/api/v1'
        NEXT_TELEMETRY_DISABLED = '1'
        NPM_CONFIG_UPDATE_NOTIFIER = 'false'
        PIP_DISABLE_PIP_VERSION_CHECK = '1'
        PIP_NO_CACHE_DIR = '1'
        PYTHON_VERSION = '3.14'
        NODE_VERSION = '22'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Quality Gates') {
            parallel {
                stage('Backend') {
                    agent {
                        docker {
                            image 'python:3.14-slim-bookworm'
                            reuseNode true
                        }
                    }
                    steps {
                        dir('backend') {
                            sh '''
                                set -eu
                                trap 'chmod -R a+rwX . || true' EXIT
                                mkdir -p reports

                                python --version
                                python -m venv .venv
                                . .venv/bin/activate
                                python -m pip install --upgrade pip
                                python -m pip install -e ".[dev]"
                                pytest -q --junitxml=reports/pytest.xml
                            '''
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'backend/reports/pytest.xml'
                        }
                    }
                }

                stage('Frontend') {
                    agent {
                        docker {
                            image 'node:22-bookworm-slim'
                            reuseNode true
                        }
                    }
                    steps {
                        dir('frontend') {
                            sh '''
                                set -eu
                                trap 'chmod -R a+rwX . || true' EXIT
                                mkdir -p reports

                                node --version
                                npm --version
                                npm ci --no-audit
                                npm run typecheck
                                npm test -- --reporter=default --reporter=junit --outputFile=reports/vitest.xml
                                npm run build
                            '''
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'frontend/reports/vitest.xml'
                        }
                    }
                }
            }
        }

        stage('Container Image Build') {
            steps {
                sh '''
                    set -eu

                    if ! command -v docker >/dev/null 2>&1; then
                        echo "Docker CLI is required for the Container Image Build stage."
                        exit 1
                    fi

                    docker build \
                        --pull \
                        --target runtime \
                        --build-arg PYTHON_VERSION="${PYTHON_VERSION}" \
                        --tag "anime-backlog-api:${BUILD_NUMBER}" \
                        backend

                    docker build \
                        --pull \
                        --target runtime \
                        --build-arg NODE_VERSION="${NODE_VERSION}" \
                        --tag "anime-backlog-frontend:${BUILD_NUMBER}" \
                        frontend
                '''
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([file(credentialsId: 'anime-backlog-env', variable: 'ENV_FILE')]) {
                    sh '''
                        set -eu

                        export API_IMAGE="anime-backlog-api:${BUILD_NUMBER}"
                        export FRONTEND_IMAGE="anime-backlog-frontend:${BUILD_NUMBER}"

                        docker compose --env-file "$ENV_FILE" up -d \
                            --remove-orphans \
                            --wait --wait-timeout 90
                    '''
                }
            }
        }
    }

    post {
        // always {
        //     cleanWs()
        // }

        success {
            sh 'docker image prune -f'
        }    
    }
}
