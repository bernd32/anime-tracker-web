def withRemoteDocker(Closure body) {
    sshagent(credentials: [env.DEPLOY_CREDENTIALS]) {
        withEnv([
            "DOCKER_HOST=ssh://${env.DEPLOY_USER}@${env.DEPLOY_HOST}",
            "DOCKER_SSH_COMMAND=ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
        ]) {
            body()
        }
    }
}

pipeline {
    agent any

    environment {
        DOCKER_BUILDKIT = '1'
        NEXT_PUBLIC_API_BASE_URL = 'http://localhost:43968/api/v1'
        NEXT_TELEMETRY_DISABLED = '1'
        NPM_CONFIG_UPDATE_NOTIFIER = 'false'
        PIP_DISABLE_PIP_VERSION_CHECK = '1'
        PIP_NO_CACHE_DIR = '1'
        PYTHON_VERSION = '3.14'
        NODE_VERSION = '22'
        DEPLOY_HOST        = '192.168.88.80'
        DEPLOY_USER        = 'admin'
        DEPLOY_CREDENTIALS = 'deploy-key-test'
        DEPLOY_ENV_FILE_CREDENTIALS = 'anime-backlog-env'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds(abortPrevious: true)
        skipDefaultCheckout(true)
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
    }



    stages {

        stage('SSH test') {

            steps {
                sshagent(credentials: [env.DEPLOY_CREDENTIALS]) {
                    sh '''
                        ssh ${DEPLOY_USER}@${DEPLOY_HOST} hostname
                    '''
                }
            }     
        }   

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Quality Gates') {
            parallel {
                stage('Backend') {
                    agent {
                        docker {
                            image 'python:3.14-slim-bookworm'
                            reuseNode true
                        }
                    }
                    steps {
                        dir('backend') {
                            sh '''
                                set -eu
                                trap 'chmod -R a+rwX . || true' EXIT
                                mkdir -p reports

                                python --version
                                python -m venv .venv
                                . .venv/bin/activate
                                python -m pip install --upgrade pip
                                python -m pip install -e ".[dev]"
                                pytest -q --junitxml=reports/pytest.xml
                            '''
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: false, testResults: 'backend/reports/pytest.xml'
                            junit 'backend/reports/pytest.xml'
                            publishHTML target: [
                            reportDir: 'backend/reports',
                            reportFiles: 'pytest.xml', 
                            reportName: 'Backend Coverage Report'                           ]
                        }
                    }
                }

                stage('Frontend') {
                    agent {
                        docker {
                            image 'node:22-bookworm-slim'
                            reuseNode true
                        }
                    }
                    steps {
                        dir('frontend') {
                            sh '''
                                set -eu
                                trap 'chmod -R a+rwX . || true' EXIT
                                mkdir -p reports

                                node --version
                                npm --version
                                npm ci --no-audit
                                npm run typecheck
                                npm test -- --reporter=default --reporter=junit --outputFile=reports/vitest.xml
                                npm run build
                            '''
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'frontend/reports/vitest.xml'
                            junit 'frontend/reports/vitest.xml'
                            publishHTML target: [
                            reportDir: 'frontend/reports',
                            reportFiles: 'pytest.xml', 
                            reportName: 'Frontend Coverage Report'  
                        }
                    }
                }
            }
        }

        stage('Container Image Build') {

            steps {
                withRemoteDocker {
                        sh '''
                            set -eu

                            docker build \
                                --pull \
                                --target runtime \
                                --build-arg PYTHON_VERSION="${PYTHON_VERSION}" \
                                --tag "anime-backlog-api:${BUILD_NUMBER}" \
                                backend

                            docker build \
                                --pull \
                                --target runtime \
                                --build-arg NODE_VERSION="${NODE_VERSION}" \
                                --tag "anime-backlog-frontend:${BUILD_NUMBER}" \
                                frontend
                        '''                    
                }
            }
        }

        stage('Deploy') {

            steps {
                withRemoteDocker {
                    withCredentials([file(credentialsId: env.DEPLOY_ENV_FILE_CREDENTIALS, variable: 'ENV_FILE')]) {
                        sh '''
                            set -eu

                            export API_IMAGE="anime-backlog-api:${BUILD_NUMBER}"
                            export FRONTEND_IMAGE="anime-backlog-frontend:${BUILD_NUMBER}"

                            docker compose \
                                --env-file "$ENV_FILE" \
                                up -d \
                                --remove-orphans \
                                --wait \
                                --wait-timeout 90
                        '''
                    }
                }
            }
        }
    }

        post {
            success {
                withRemoteDocker {
                    sh 'docker image prune -f'
                }
            }
        }
}