# Shared Compose variables
COMPOSE_PROJECT_NAME=anime-backlog

# PostgreSQL
POSTGRES_DB=anime_backlog
POSTGRES_USER=anime
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Published ports
API_PORT=43968
FRONTEND_PORT=20773

# Frontend public API base URL used by the browser.
# For local Compose, localhost is correct.
# For a VPS, set this to your public API URL, e.g. https://anime.example.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:43968/api/v1

# Backend runtime
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO
UVICORN_WORKERS=1
CORS_ALLOW_ORIGINS=["http://localhost:20773","http://127.0.0.1:20773"]
AUTH_OWNER_USERNAME=owner
AUTH_OWNER_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
AUTH_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
AUTH_SESSION_MAX_AGE_SECONDS=2592000

# Shikimori
SHIKIMORI_GRAPHQL_URL=https://shikimori.one/api/graphql
SHIKIMORI_REQUEST_TIMEOUT_SECONDS=10
SHIKIMORI_CACHE_TTL_SECONDS=31536000
SHIKIMORI_USER_AGENT=anime-backlog-web/1.0
SHIKIMORI_HTTPS_PROXY_URL=
SHIKIMORI_SOCKS5_PROXY_URL=
