# PostgreSQL
POSTGRES_DB=anime_backlog
POSTGRES_USER=anime
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

CORS_ALLOW_ORIGINS=["http://localhost:20773","http://127.0.0.1:20773"]
AUTH_OWNER_USERNAME=owner
AUTH_OWNER_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
AUTH_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Shared Compose variables
# COMPOSE_PROJECT_NAME=anime-backlog

# Deployment images
# The database should use the official PostgreSQL image.
# DB_IMAGE=postgres:17-alpine
# API_IMAGE=skeirs/anime-backlog-api:2
# FRONTEND_IMAGE=skeirs/anime-backlog-frontend:2



# Published ports
# API_PORT=43968
# FRONTEND_PORT=20773

# Frontend server-side proxy target.
# In Docker Compose, the default backend service URL is correct.
# Override this only when the frontend server must reach the API at a different address.
# API_PROXY_TARGET=http://api:43968/api/v1

# Backend runtime
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=INFO

# AUTH_SESSION_MAX_AGE_SECONDS=2592000
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_WINDOW_SECONDS=600
# AUTH_LOGIN_LOCKOUT_SECONDS=900

# Shikimori anime info fetch via api 
# SHIKIMORI_GRAPHQL_URL=https://shikimori.io/api/graphql
# SHIKIMORI_REQUEST_TIMEOUT_SECONDS=10
# SHIKIMORI_CACHE_TTL_SECONDS=31536000
# SHIKIMORI_USER_AGENT=anime-backlog-web/1.0
# # E.g.:  socks5://host.docker.internal:10808 
# SHIKIMORI_SOCKS5_PROXY_URL=
# SHIKIMORI_HTTPS_PROXY_URL=
