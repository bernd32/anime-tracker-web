APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
AUTH_OWNER_USERNAME=owner
AUTH_OWNER_PASSWORD=change-this-dev-password
AUTH_SESSION_SECRET=change-this-dev-session-secret-at-least-32-bytes
AUTH_SESSION_MAX_AGE_SECONDS=2592000
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=600
AUTH_LOGIN_LOCKOUT_SECONDS=900

# In Docker Compose this is injected automatically.
# For running backend outside Compose, set it explicitly.
DATABASE_URL=postgresql+psycopg://anime:change-me@localhost:5432/anime_backlog

SHIKIMORI_GRAPHQL_URL=https://shikimori.one/api/graphql
SHIKIMORI_REQUEST_TIMEOUT_SECONDS=10
SHIKIMORI_CACHE_TTL_SECONDS=31536000
SHIKIMORI_USER_AGENT=anime-backlog-web/1.0
SHIKIMORI_HTTPS_PROXY_URL=
SHIKIMORI_SOCKS5_PROXY_URL=

# JSON array string
CORS_ALLOW_ORIGINS=["http://localhost:20773","http://127.0.0.1:20773"]
